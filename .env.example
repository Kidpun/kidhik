# ============================================================
# KidHik Userbot — конфиг
# Скопируйте этот файл в .env и заполните своими данными
# ============================================================

# Telegram API credentials
# Получить: https://my.telegram.org/apps
API_ID=YOUR_API_ID
API_HASH=YOUR_API_HASH

# Токен бота-помощника (для настройки через /start)
# Создать: @BotFather в Telegram
BOT_TOKEN=YOUR_BOT_TOKEN

# Spotify (опционально, для команды .музыка)
# Создать: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=https://yourdomain.com/spotify/callback

# Yandex Music (опционально)
YANDEX_TOKEN=

# Google Gemini AI (опционально, для команды .ai)
# Получить: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Google Custom Search (опционально, для .ai поиска)
GOOGLE_SEARCH_CX=

# FunStat API (опционально, для истории профилей)
# Получить: https://funstat.info/
FUNSTAT_TOKEN=

# Прокси настройки (опционально)
# Форматы: socks5://user:pass@host:port  или  http://host:port
PROXY_URL=

# Язык интерфейса
LANG_CODE=ru
SYSTEM_LANG_CODE=en-US
